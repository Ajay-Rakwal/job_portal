# Copy this file to .env and fill in your values

# Server port
PORT=5000

# JWT Secret - change this to a strong random string in production
JWT_SECRET=job_portal_super_secret_jwt_key_2026

# MongoDB connection string
# For local: mongodb://localhost:27017/job-portal
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/job-portal
MONGODB_URI=mongodb://localhost:27017/job-portal
